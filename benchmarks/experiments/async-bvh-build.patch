 #[derive(Resource, Default)]
 pub struct ExtractedVoxelScenes(pub FxHashMap<Entity, ExtractedVoxelScene>);
 
+/// The BVH is built on a dedicated thread, started in extraction and joined in the render world's
+/// prepare stage. That keeps a full SAH rebuild every frame (needed once things move) out of
+/// extraction, which blocks the main world. Not a task-pool task: the build fans out on the compute
+/// pool itself, and the async pool is full of long-running streaming work that would starve it.
+pub enum SceneBvh {
+	Empty,
+	Building(crossbeam_channel::Receiver<BVH<u32>>),
+	Ready(BVH<u32>),
+}
+
+type BvhJob = (Vec<(u32, (Vec3, Vec3))>, crossbeam_channel::Sender<BVH<u32>>);
+
+fn spawn_bvh_build(items: Vec<(u32, (Vec3, Vec3))>) -> crossbeam_channel::Receiver<BVH<u32>> {
+	static WORKER: std::sync::OnceLock<crossbeam_channel::Sender<BvhJob>> = std::sync::OnceLock::new();
+	let worker = WORKER.get_or_init(|| {
+		let (sender, receiver) = crossbeam_channel::unbounded::<BvhJob>();
+		std::thread::Builder::new()
+			.name("voxel BVH builder".into())
+			.spawn(move || {
+				for (items, result) in receiver {
+					let _ = result.send(BVH::new(items));
+				}
+			})
+			.expect("failed to start the BVH builder thread");
+		sender
+	});
+	let (sender, receiver) = crossbeam_channel::bounded(1);
+	worker.send((items, sender)).expect("BVH builder thread exited");
+	receiver
+}
+
+impl SceneBvh {
+	pub fn ready(&self) -> Option<&BVH<u32>> {
+		match self {
+			Self::Ready(bvh) => Some(bvh),
+			_ => None,
+		}
+	}
+}
+
+/// Waits for this frame's BVH builds. Runs on the render thread just before bind groups are made.
+pub fn finish_bvh_builds(mut scenes: ResMut<ExtractedVoxelScenes>) {
+	for scene in scenes.0.values_mut() {
+		if matches!(scene.bvh, SceneBvh::Building(_)) {
+			let SceneBvh::Building(result) = std::mem::replace(&mut scene.bvh, SceneBvh::Empty) else { unreachable!() };
+			scene.bvh = SceneBvh::Ready(result.recv().expect("BVH builder thread exited"));
+		}
+	}
+}
+
 /// Render-world mirror of the tiles each view draws, kept across frames. Per frame, only tiles that
 /// moved or were rebuilt are touched, so extraction cost follows what changed, not how many tiles
 /// are in view.
