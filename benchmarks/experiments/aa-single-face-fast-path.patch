+uint contribution_face(VoxelContribution contribution) {
+	let axis = (contribution.normal >> 3u) & 0xFu;
+	return axis | (((contribution.normal >> axis) & 1u) << 2u);
+}
+
+/// True when all four corner rays hit the same unoccluded face of the same voxel with the same
+/// sampler color key. The face is convex and so is each color-key region on it, so every sample
+/// ray between the corners hits that face with that color, normal, and shadow: the 16-sample
+/// result is that one shaded color.
+bool single_face_pixel(VoxelContribution top_left, VoxelContribution top_right, VoxelContribution bottom_left, VoxelContribution bottom_right) {
+	if (!(same_voxel(top_left, top_right) && same_voxel(top_left, bottom_left) && same_voxel(top_left, bottom_right))) { return false; }
+	let face = contribution_face(top_left);
+	if (contribution_face(top_right) != face || contribution_face(bottom_left) != face || contribution_face(bottom_right) != face) { return false; }
+	if ((top_left.camera_face_occlusion_mask & (1u << (face & 3u))) != 0u) { return false; }
+	if (top_left.light_visible != top_right.light_visible || top_left.light_visible != bottom_left.light_visible || top_left.light_visible != bottom_right.light_visible) { return false; }
+	let key = voxel_color_cache_key(top_left, top_left.surface_pos);
+	return key != VOXEL_COLOR_NO_CACHE
+		&& voxel_color_cache_key(top_right, top_right.surface_pos) == key
+		&& voxel_color_cache_key(bottom_left, bottom_left.surface_pos) == key
+		&& voxel_color_cache_key(bottom_right, bottom_right.surface_pos) == key;
+}
