+
+/// Selects the buffer per BVH item at runtime, so the DDA is compiled once instead of once per
+/// data source. Set before each traversal (1 = residency, 2 = main).
+static uint dda_selected_source = 1u;
+
+struct SelectedDDADataSource : IDDADataSource {
+	uint dda_u32(uint byte_offset) {
+		return dda_selected_source == 2u ? main_grid_tree_buf[byte_offset / 4u] : residency_grid_tree_buf[byte_offset / 4u];
+	}
+};
